diff --git a/compiler/optimizing/intrinsics_x86_64.cc b/compiler/optimizing/intrinsics_x86_64.cc
index 01368ff..d098b25 100644
--- a/compiler/optimizing/intrinsics_x86_64.cc
+++ b/compiler/optimizing/intrinsics_x86_64.cc
@@ -131,8 +131,19 @@ class ReadBarrierSystemArrayCopySlowPathX86_64 : public SlowPathCode {
     // entrypoint. Also, there is no need to update the stack mask,
     // as this runtime call will not trigger a garbage collection.
     int32_t entry_point_offset = Thread::ReadBarrierMarkEntryPointsOffset<kX86_64PointerSize>(TMP);
+#if defined(ANDRUNA)
+    // The reference to mark is in TMP, which gs() would overwrite with the
+    // Thread*: load the Thread* into `src_stop_addr`, saved around the call
+    // (twice, to keep the stack 16-byte aligned for the entrypoint).
+    __ pushq(src_stop_addr);
+    __ pushq(src_stop_addr);
+    __ gs(src_stop_addr)->call(Address::Absolute(entry_point_offset, /* no_rip= */ true));
+    __ popq(src_stop_addr);
+    __ popq(src_stop_addr);
+#else
     // This runtime call does not require a stack map.
     x86_64_codegen->InvokeRuntimeWithoutRecordingPcInfo(entry_point_offset, instruction_, this);
+#endif
     __ MaybePoisonHeapReference(CpuRegister(TMP));
     __ movl(Address(dst_curr_addr, 0), CpuRegister(TMP));
     __ addl(src_curr_addr, Immediate(element_size));
