+      __ gs(CpuRegister(R10))->call(Address::Absolute(
+          GetThreadOffset<kX86_64PointerSize>(kQuickUpdateInlineCache).Int32Value(),
+          /* no_rip= */ true));
+#else
       GenerateInvokeRuntime(
           GetThreadOffset<kX86_64PointerSize>(kQuickUpdateInlineCache).Int32Value());
+#endif
       __ Bind(&done);
