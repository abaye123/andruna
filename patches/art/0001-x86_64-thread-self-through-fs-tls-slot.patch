Reach the x86_64 Thread* through bionic's TLS slot in the ANDRUNA build.

ART on x86_64 sets the GS base to the current Thread* with
arch_prctl(ARCH_SET_GS) and its assembly reads Thread fields as
%gs:offset. On Windows x64 GS is the TEB and user mode cannot change it.
Under ANDRUNA the Thread* stays only in TLS_SLOT_ART_THREAD_SELF, which
bionic keeps at %fs:0x38 (ART already stores it there for
Thread::Current()). Thread::Current() loads become one FS-relative load
(GS_SELF); other fields load the Thread* into a dead scratch register
first (LOAD_THREAD_FIELD_BASE + THREAD_FIELD). Without ANDRUNA the macros
expand to the original %gs: forms. The compiler's generated code is
patched separately.

diff --git a/runtime/arch/x86_64/asm_support_x86_64.S b/runtime/arch/x86_64/asm_support_x86_64.S
index bf0b958..11dd0a7 100644
--- a/runtime/arch/x86_64/asm_support_x86_64.S
+++ b/runtime/arch/x86_64/asm_support_x86_64.S
@@ -60,6 +60,27 @@
     #define MACRO_LITERAL(value) $value
 #endif
 
+// Access to the current Thread. Android sets the GS base to the Thread*
+// (arch_prctl(ARCH_SET_GS)) and reads its fields as %gs:offset. Under
+// ANDRUNA (Windows x64, where GS is the TEB and cannot be changed) the
+// Thread* is read from bionic's TLS slot TLS_SLOT_ART_THREAD_SELF at
+// %fs:(8 * 7), and other fields go through a scratch register:
+//     LOAD_THREAD_FIELD_BASE r10
+//     movq %rsp, THREAD_FIELD(THREAD_TOP_QUICK_FRAME_OFFSET, r10)
+#if defined(ANDRUNA)
+#define ANDRUNA_TLS_ART_THREAD_SELF_OFFSET 0x38
+#define GS_SELF %fs:ANDRUNA_TLS_ART_THREAD_SELF_OFFSET
+#define THREAD_FIELD(offset, scratch) offset(%scratch)
+MACRO1(LOAD_THREAD_FIELD_BASE, scratch)
+    movq %fs:ANDRUNA_TLS_ART_THREAD_SELF_OFFSET, REG_VAR(scratch)
+END_MACRO
+#else
+#define GS_SELF %gs:THREAD_SELF_OFFSET
+#define THREAD_FIELD(offset, scratch) %gs:offset
+MACRO1(LOAD_THREAD_FIELD_BASE, scratch)
+END_MACRO
+#endif
+
 #if defined(__APPLE__)
     #define FUNCTION_TYPE(name)
     #define SIZE(name)
