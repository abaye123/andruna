+#if defined(ANDRUNA)
+    LOAD_THREAD_FIELD_BASE rax            // RAX is overwritten with the lock word below.
+    movl THREAD_FIELD(THREAD_ID_OFFSET, rax), REG_VAR(tmp)  // tmp: thread id.
+    movl MIRROR_OBJECT_LOCK_WORD_OFFSET(REG_VAR(obj)), %eax  // EAX := lock word
+#else
     movl MIRROR_OBJECT_LOCK_WORD_OFFSET(REG_VAR(obj)), %eax  // EAX := lock word
