+#if defined(ANDRUNA)
+// Andruna (Windows x64): GS is the TEB, so there is no %gs:offset access to
+// the Thread. gs() loads the Thread* from bionic's TLS slot
+// TLS_SLOT_ART_THREAD_SELF (%fs:0x38) into R11 (TMP), or into the register
+// given, and the next instruction's absolute operand [disp32] is emitted as
+// [base + disp32]. The base register must not be an input of that
+// instruction. Flags are not changed.
+X86_64Assembler* X86_64Assembler::gs() {
+  return gs(CpuRegister(R11));
+}
+
+X86_64Assembler* X86_64Assembler::gs(CpuRegister thread_base) {
+  CHECK(!thread_base_pending_);
+  {
+    AssemblerBuffer::EnsureCapacity ensured(&buffer_);
+    EmitUint8(0x64);  // FS
+  }
+  movq(thread_base, Address::Absolute(0x38, /*no_rip=*/ true));
+  thread_base_ = thread_base.AsRegister();
+  thread_base_pending_ = true;
+  return this;
+}
+
+const Operand& X86_64Assembler::ThreadRelative(const Operand& operand) {
+  if (!thread_base_pending_) {
+    return operand;
+  }
+  // Only the absolute form Address::Absolute(disp, /*no_rip=*/ true) follows gs().
+  CHECK_EQ(operand.mod(), 0);
+  CHECK_EQ(operand.rm(), RSP);
+  CHECK_EQ(operand.base(), RBP);
+  CHECK_EQ(operand.rex(), 0);
+  thread_operand_.emplace(CpuRegister(thread_base_), operand.disp32());
+  return *thread_operand_;
+}
+#else
 X86_64Assembler* X86_64Assembler::gs() {
   // TODO: gs is a prefix and not an instruction
   AssemblerBuffer::EnsureCapacity ensured(&buffer_);
   EmitUint8(0x65);
   return this;
 }
+#endif
 
 
