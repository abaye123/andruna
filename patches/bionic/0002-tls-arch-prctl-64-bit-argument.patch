Pass the x86_64 thread pointer to arch_prctl as a 64-bit value in the ANDRUNA build.

Andruna compiles AOSP code for a Windows target, where `unsigned long` is
32 bits (LLP64), so the upstream cast truncates the pointer and does not
compile. Under ANDRUNA the declaration and the cast use
`unsigned long long`, the width of the kernel argument.

diff --git a/libc/platform/bionic/tls.h b/libc/platform/bionic/tls.h
index 3e0ef53..7f4f793 100644
--- a/libc/platform/bionic/tls.h
+++ b/libc/platform/bionic/tls.h
@@ -93,11 +93,20 @@ static inline void** __get_tls(void) {
 #include <asm/prctl.h>
 // This syscall stub is generated but it's not declared in any header.
 __BEGIN_DECLS
+#if defined(ANDRUNA)
+// LLP64: `unsigned long` is 32 bits; the kernel argument is 64 bits.
+int arch_prctl(int, unsigned long long);
+#else
 int arch_prctl(int, unsigned long);
+#endif
 __END_DECLS
 
 static inline int __set_tls(void* tls) {
+#if defined(ANDRUNA)
+  return arch_prctl(ARCH_SET_FS, reinterpret_cast<unsigned long long>(tls));
+#else
   return arch_prctl(ARCH_SET_FS, reinterpret_cast<unsigned long>(tls));
+#endif
 }
 
 #else
