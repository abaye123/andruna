# bionic for the Andruna guest: libc.so, libm.so, libdl.so, the crt objects
# and the bridge ld-android.so, as Android ELF (ADR 0013), with system calls
# routed to the host (aosp/bionic/README.md).
#
# The source lists come from bionic's Android.bp files through
# aosp/tools/blueprint.py (cmake/blueprint.cmake); this file spells out
# what Andruna changes:
#
# - System call stubs are generated by aosp/tools/gensyscalls_andruna.py
#   (calls to __andruna_syscall instead of the syscall instruction).
# - The assembler files that execute system calls directly are replaced by
#   aosp/bionic/ (syscall(), __bionic_clone, _exit_with_stack_teardown,
#   vfork).
# - bionic's Rust pieces are not built: ICU4X's Unicode properties
#   (__icu4x_bionic_*) are provided by the host; liblibc_alloc_rust and
#   libbionic_panic_abort only serve Rust code, and libc has none here.
# - LLVM's libunwind is linked into libc.so and exported, as Android's
#   libunwind-exported.
# - ld-android.so is Andruna's bridge between andruna-linker and libc
#   (aosp/bionic/ld_android_bridge.cpp), linked with the static parts of
#   libc the way Android's linker is.
#
# Included by aosp/guest/CMakeLists.txt in the `bionic` stage. Inputs: AOSP,
# ANDRUNA_ARCH, ANDRUNA_LLVM_PROJECT, ANDRUNA_ELF_BUILTINS.

include("${CMAKE_CURRENT_LIST_DIR}/../cmake/blueprint.cmake")

if(ANDRUNA_ARCH STREQUAL "x64")
  set(BP_ARCH x86_64)
else()
  set(BP_ARCH arm64)
endif()

set(BIONIC "${AOSP}/bionic")
set(ANDRUNA_BIONIC_DIR "${CMAKE_CURRENT_LIST_DIR}/../bionic")
get_filename_component(ANDRUNA_BIONIC_DIR "${ANDRUNA_BIONIC_DIR}" ABSOLUTE)
set(BIONIC_GEN "${CMAKE_BINARY_DIR}/gen")
file(MAKE_DIRECTORY "${BIONIC_GEN}")

# ---------------------------------------------------------------------------
# Android.bp modules

set(_libc_modules
  libc_bionic libc_bootstrap libc_init_static libc_init_dynamic libc_tzcode
  libc_dns libc_freebsd libc_freebsd_ldexp libc_freebsd_large_stack
  libc_netbsd libc_openbsd libc_openbsd_large_stack libc_gdtoa libc_fortify
  libc_syscalls libc_aeabi libc_common libc_dynamic_dispatch
  libc_common_shared libc_unwind_static libc_nomalloc libstdc++)
if(BP_ARCH STREQUAL "x86_64")
  list(APPEND _libc_modules
    libc_bionic_portable_simd_x86_64_v2 libc_bionic_portable_simd_x86_64_v3)
else()
  list(APPEND _libc_modules
    libc_bionic_portable_simd_arm64_neon_no_mte libc_bionic_portable_simd_arm64_neon_mte)
endif()
set(_mods)
foreach(m ${_libc_modules})
  list(APPEND _mods "bionic/libc/Android.bp:${m}")
endforeach()
list(APPEND _mods
  "bionic/libc/Android.bp:libc:shared"
  "bionic/libc/async_safe/Android.bp:libasync_safe"
  "bionic/libc/system_properties/Android.bp:libsystemproperties"
  "system/core/property_service/libpropertyinfoparser/Android.bp:libpropertyinfoparser"
  "external/llvm-libc/Android.bp:llvmlibc"
  "external/scudo/Android.bp:libscudo"
  "external/gwp_asan/Android.bp:gwp_asan"
  "external/arm-optimized-routines/Android.bp:libarm-optimized-routines-string"
  "external/arm-optimized-routines/Android.bp:libarm-optimized-routines-math"
  "bionic/libm/Android.bp:libm:shared"
  "bionic/libdl/Android.bp:libdl_static"
  "bionic/libdl/Android.bp:libdl:shared"
  "bionic/libdl/Android.bp:libdl_android:shared"
  "bionic/libc/Android.bp:crtbrand"
  "bionic/libc/Android.bp:crtbegin_so"
  "bionic/libc/Android.bp:crtend_so"
  "bionic/libc/Android.bp:crtbegin_dynamic"
  "bionic/libc/Android.bp:crtend_android")
bp_read(bionic ARCH ${BP_ARCH} MODULES ${_mods}
  READ
    bionic/libm/Android.bp
    system/logging/liblog/Android.bp
    external/gwp_asan/Android.bp
    external/google-highway/Android.bp)

# ---------------------------------------------------------------------------
# Compilation environment

# Soong's device defaults for platform C/C++ code, then each module's
# flags. Warnings are not errors: the module flags carry -Werror for
# Android's own compiler, not for this one.
set(ANDRUNA_BP_BASE_OPTIONS
  -nostdlibinc
  -DANDRUNA
  # Soong's device default; bionic declares the fortified entry points
  # (__open_2, ...) only under it.
  -U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=2
  # Soong's platform_sdk_version product variable (crtbrand.S): the SDK
  # level of android-17.0.0_r1 (aosp.lock).
  $<$<COMPILE_LANGUAGE:ASM>:-DPLATFORM_SDK_VERSION=37>
  -fPIC -O2 -g
  -funwind-tables -ffunction-sections -fdata-sections
  -fstack-protector-strong
  -fno-strict-aliasing
  -fdebug-prefix-map=${AOSP}=aosp
  $<$<COMPILE_LANGUAGE:CXX>:-fno-exceptions>
  $<$<COMPILE_LANGUAGE:CXX>:-fno-rtti>
  $<$<COMPILE_LANGUAGE:CXX>:-nostdinc++>
  "-I${BIONIC_GEN}"
  # bionic's own headers (libc_headers), for the modules whose header_libs
  # do not name them.
  "SHELL:-isystem ${BIONIC}/libc/include"
  "SHELL:-isystem ${BIONIC}/libc/kernel/uapi"
  "SHELL:-isystem ${BIONIC}/libc/kernel/android/uapi"
  "SHELL:-isystem ${BIONIC}/libc/kernel/uapi/asm-${BIONIC_ASM_ARCH}")
set(ANDRUNA_BP_LATE_OPTIONS -w -Wno-error)

# ---------------------------------------------------------------------------
# Generated sources

set(_syscalls "${BIONIC_GEN}/syscalls-${BP_ARCH}.S")
add_custom_command(
  OUTPUT "${_syscalls}"
  COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_LIST_DIR}/../tools/gensyscalls_andruna.py"
          ${BP_ARCH} "${BIONIC}/libc/SYSCALLS.TXT" > "${_syscalls}"
  DEPENDS "${BIONIC}/libc/SYSCALLS.TXT" "${BIONIC}/libc/tools/gensyscalls.py"
          "${CMAKE_CURRENT_LIST_DIR}/../tools/gensyscalls_andruna.py"
  COMMENT "Generating bionic system call stubs (host calls)"
  VERBATIM)

set(_ids "${BIONIC_GEN}/generated_android_ids.h")
add_custom_command(
  OUTPUT "${_ids}"
  COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_LIST_DIR}/../tools/gen_android_ids.py"
          "${AOSP}/system/core/libcutils/include/private/android_filesystem_config.h" "${_ids}"
  DEPENDS "${CMAKE_CURRENT_LIST_DIR}/../tools/gen_android_ids.py"
  COMMENT "Generating generated_android_ids.h"
  VERBATIM)
add_custom_target(bionic_generated_headers DEPENDS "${_ids}")

function(bionic_version_script out name input)
  add_custom_command(
    OUTPUT "${out}"
    COMMAND "${Python3_EXECUTABLE}" "${BIONIC}/tools/generate-version-script.py"
            ${BP_ARCH} "${input}" "${out}"
    DEPENDS "${input}" "${BIONIC}/tools/generate-version-script.py"
    COMMENT "Generating ${name}"
    VERBATIM)
endfunction()
set(_libc_map "${BIONIC_GEN}/libc.${BP_ARCH}.map")
set(_libm_map "${BIONIC_GEN}/libm.${BP_ARCH}.map")
set(_libdl_map "${BIONIC_GEN}/libdl.${BP_ARCH}.map")
bionic_version_script("${_libc_map}" libc.map "${BIONIC}/libc/libc.map.txt")
bionic_version_script("${_libm_map}" libm.map "${BIONIC}/libm/libm.map.txt")
bionic_version_script("${_libdl_map}" libdl.map "${BIONIC}/libdl/libdl.map.txt")
add_custom_target(bionic_version_scripts DEPENDS "${_libc_map}" "${_libm_map}" "${_libdl_map}")

# ---------------------------------------------------------------------------
# The host stub library: one empty function per name of host_symbols.txt.

set(_host_list "${ANDRUNA_BIONIC_DIR}/host_symbols.txt")
file(STRINGS "${_host_list}" _host_lines)
set(_host_c "// Generated from aosp/bionic/host_symbols.txt. Do not edit.\n")
foreach(l ${_host_lines})
  string(STRIP "${l}" l)
  if(l STREQUAL "" OR l MATCHES "^#")
    continue()
  endif()
  string(APPEND _host_c "void ${l}(void) {}\n")
endforeach()
file(WRITE "${BIONIC_GEN}/andruna_host_stub.c.new" "${_host_c}")
file(COPY_FILE "${BIONIC_GEN}/andruna_host_stub.c.new" "${BIONIC_GEN}/andruna_host_stub.c" ONLY_IF_DIFFERENT)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_host_list}")
add_library(andruna_host SHARED "${BIONIC_GEN}/andruna_host_stub.c")
target_compile_options(andruna_host PRIVATE -nostdlibinc -fPIC -w)
target_link_options(andruna_host PRIVATE -Wl,-soname,libandruna_host.so)
set_target_properties(andruna_host PROPERTIES OUTPUT_NAME andruna_host)

include("${CMAKE_CURRENT_LIST_DIR}/bionic_libc.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/bionic_libdl.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/bionic_libm.cmake")

# ---------------------------------------------------------------------------
# Installation into the sysroot (usr/lib), as the NDK lays it out.

install(TARGETS c_so m_so dl_so ld_android_so andruna_host
  LIBRARY DESTINATION lib)
install(FILES ${BIONIC_CRT_OBJECTS} DESTINATION lib)
