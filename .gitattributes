# Text files use LF in the repository and in every checkout, so rustfmt
# (newline_style = "Unix") and `git apply` of AOSP patches behave the same on
# every host, whatever core.autocrlf is set to.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
