<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Andruna.Manager.Pages.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Andruna.Manager.Localization"
    xmlns:local="using:Andruna.Manager.Pages"
    xmlns:vm="using:Andruna.Manager.Core.ViewModels">

    <ScrollViewer>
        <StackPanel Padding="36,20,36,36" MaxWidth="1000" HorizontalAlignment="Stretch">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{l:Str Key=DiagTitle}" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Click="OnRefreshClick" ToolTipService.ToolTip="{l:Str Key=DiagRefresh}" AutomationProperties.Name="{l:Str Key=DiagRefresh}">
                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                </Button>
                <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Click="OnSaveReportClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                        <TextBlock Text="{l:Str Key=DiagSaveReport}" />
                    </StackPanel>
                </Button>
            </Grid>

            <InfoBar x:Name="ReportBar" Margin="0,16,0,0" IsClosable="True" />

            <TextBlock Text="{l:Str Key=DiagServiceHeader}" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE9F5;" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Vm.ServiceText, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Vm.ServiceDetail, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="{l:Str Key=DiagCrashesHeader}" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="{x:Bind Vm.CrashesNote, Mode=OneWay}" Visibility="{x:Bind local:Ui.NotEmpty(Vm.CrashesNote), Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <ItemsRepeater ItemsSource="{x:Bind Vm.Crashes}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="10" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:CrashRow">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE783;" FontSize="16" Foreground="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind Explanation}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind TimeText}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <TextBlock Text="{l:Str Key=DiagMissingHeader}" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{l:Str Key=DiagMissingDescription}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="AppChoice" Header="{l:Str Key=DiagAppLabel}" MinWidth="320" ItemsSource="{x:Bind Vm.Apps}"
                              SelectionChanged="OnAppChanged" />
                    <TextBlock Text="{x:Bind Vm.MissingNote, Mode=OneWay}" Visibility="{x:Bind local:Ui.NotEmpty(Vm.MissingNote), Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="16" Padding="0,4" Visibility="{x:Bind local:Ui.Empty(Vm.MissingNote), Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{l:Str Key=DiagColumnArea}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="{l:Str Key=DiagColumnFunction}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="2" Text="{l:Str Key=DiagColumnCalls}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                    </Grid>
                    <ItemsRepeater ItemsSource="{x:Bind Vm.MissingFunctions}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="4" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:MissingFunctionRow">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Area}" FontFamily="Consolas" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontFamily="Consolas" FlowDirection="LeftToRight" HorizontalAlignment="Left"
                                               TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind CallsText}" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <TextBlock Text="{l:Str Key=DiagLogsHeader}" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <RadioButtons x:Name="LogChoice" MaxColumns="2" SelectionChanged="OnLogChanged" />
                        <Button Grid.Column="1" Content="{l:Str Key=DiagOpenLogs}" Click="OnOpenLogsClick" VerticalAlignment="Center" />
                    </Grid>
                    <TextBox Text="{x:Bind Vm.LogText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             FontFamily="Consolas" FontSize="12" Height="280" FlowDirection="LeftToRight"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
