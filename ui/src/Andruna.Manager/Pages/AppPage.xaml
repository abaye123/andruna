<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Andruna.Manager.Pages.AppPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Andruna.Manager.Localization"
    xmlns:local="using:Andruna.Manager.Pages"
    xmlns:vm="using:Andruna.Manager.Core.ViewModels">

    <ScrollViewer>
        <StackPanel Padding="36,20,36,36" MaxWidth="1000" HorizontalAlignment="Stretch">

            <!-- Header: icon, name, package, version, and the main actions. Only what sysd reported. -->
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="72" Height="72" CornerRadius="16" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <FontIcon Glyph="&#xE71D;" FontSize="36" Visibility="{x:Bind local:Ui.Hide(Vm.HasIcon), Mode=OneWay}" />
                    <Image Source="{x:Bind local:Ui.Image(Vm.IconPath), Mode=OneWay}" Visibility="{x:Bind local:Ui.Visible(Vm.HasIcon), Mode=OneWay}" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind Vm.Title, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Vm.PackageName}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FlowDirection="LeftToRight" HorizontalAlignment="Left" IsTextSelectionEnabled="True" />
                    <TextBlock Text="{x:Bind Vm.VersionText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Style="{StaticResource AccentButtonStyle}" IsEnabled="{x:Bind Vm.CanOpen, Mode=OneWay}" Click="OnOpenClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                            <TextBlock Text="{l:Str Key=AppOpenButton}" />
                        </StackPanel>
                    </Button>
                    <Button IsEnabled="{x:Bind Vm.CanPin, Mode=OneWay}" Click="OnPinClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE718;" FontSize="14" />
                            <TextBlock Text="{l:Str Key=AppPinButton}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <InfoBar Margin="0,20,0,0"
                     IsOpen="{x:Bind Vm.HasProblem, Mode=OneWay}"
                     IsClosable="False"
                     Severity="Warning"
                     Title="{x:Bind Vm.Problem.Title, Mode=OneWay, FallbackValue=''}"
                     Message="{x:Bind Vm.Problem.Message, Mode=OneWay, FallbackValue=''}" />
            <InfoBar Margin="0,12,0,0"
                     IsOpen="{x:Bind Vm.HasNotice, Mode=OneWay}"
                     IsClosable="True"
                     Severity="Informational"
                     Title="{x:Bind Vm.Notice.Title, Mode=OneWay, FallbackValue=''}"
                     Message="{x:Bind Vm.Notice.Message, Mode=OneWay, FallbackValue=''}" />

            <TextBlock Text="{l:Str Key=AppSectionPermissions}" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="{l:Str Key=AppSectionPermissionsDescription}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind Vm.PermissionsNote, Mode=OneWay}" Visibility="{x:Bind local:Ui.NotEmpty(Vm.PermissionsNote), Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <ItemsRepeater ItemsSource="{x:Bind Vm.PermissionList, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:PermissionItem">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE72E;" FontSize="14" Visibility="{x:Bind local:Ui.Visible(IsSensitive)}" VerticalAlignment="Top" Margin="0,3,0,0" />
                                    <FontIcon Glyph="&#xE73E;" FontSize="14" Visibility="{x:Bind local:Ui.Hide(IsSensitive)}" VerticalAlignment="Top" Margin="0,3,0,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource CaptionTextBlockStyle}" FlowDirection="LeftToRight"
                                                   HorizontalAlignment="Left" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <TextBlock Text="{l:Str Key=AppSectionStorage}" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xEDA2;" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{l:Str Key=AppSectionStorageDescription}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="24">
                            <StackPanel>
                                <TextBlock Text="{l:Str Key=AppSizeLabel}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind Vm.SizeText, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{l:Str Key=AppDataSizeLabel}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind Vm.DataSizeText, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Visibility="{x:Bind local:Ui.NotEmpty(Vm.InstalledText), Mode=OneWay}">
                                <TextBlock Text="{l:Str Key=AppInstalledLabel}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind Vm.InstalledText, Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                        <Button Content="{l:Str Key=AppClearData}" IsEnabled="{x:Bind Vm.CanClearData}" HorizontalAlignment="Stretch" />
                        <TextBlock Text="{l:Str Key=AppNotAvailableYet}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="{l:Str Key=AppSectionWindow}" Style="{StaticResource SectionHeaderStyle}" />
            <StackPanel Spacing="4">
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE740;" FontSize="20" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{l:Str Key=AppSectionWindowDescription}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{l:Str Key=AppNotAvailableYet}" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE950;" FontSize="20" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{l:Str Key=AppSectionGpu}" />
                            <TextBlock Text="{l:Str Key=AppSectionGpuDescription}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{l:Str Key=AppNotAvailableYet}" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </Grid>
                </Border>
            </StackPanel>

            <TextBlock Text="{l:Str Key=AppSectionUninstall}" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE74D;" FontSize="20" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{l:Str Key=AppSectionUninstallDescription}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <Button Content="{l:Str Key=AppDiagnosticsButton}" Click="OnDiagnosticsClick" />
                        <Button Content="{l:Str Key=AppUninstallButton}" IsEnabled="{x:Bind Vm.CanUninstall, Mode=OneWay}" Click="OnUninstallClick" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
