<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Andruna.Manager.Pages.AppPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Andruna.Manager.Localization">

    <ScrollViewer>
        <StackPanel Padding="36,20,36,36" MaxWidth="1000" HorizontalAlignment="Stretch">

            <!-- Header: icon, name, package, version. Only what sysd reported. -->
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="72" Height="72" CornerRadius="16" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <FontIcon Glyph="&#xE71D;" FontSize="36" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind Vm.Title, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Vm.PackageName}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FlowDirection="LeftToRight" HorizontalAlignment="Left" IsTextSelectionEnabled="True" />
                    <TextBlock Text="{x:Bind Vm.VersionText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <InfoBar Margin="0,20,0,0"
                     IsOpen="{x:Bind Vm.HasProblem, Mode=OneWay}"
                     IsClosable="False"
                     Severity="Warning"
                     Title="{x:Bind Vm.Problem.Title, Mode=OneWay, FallbackValue=''}"
                     Message="{x:Bind Vm.Problem.Message, Mode=OneWay, FallbackValue=''}" />

            <TextBlock Text="{l:Str Key=AppSectionPermissions}" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE72E;" FontSize="20" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{l:Str Key=AppSectionPermissionsDescription}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{l:Str Key=AppNotAvailableYet}" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </Grid>
            </Border>

            <TextBlock Text="{l:Str Key=AppSectionStorage}" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xEDA2;" FontSize="20" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{l:Str Key=AppSectionStorageDescription}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <Button Content="{l:Str Key=AppClearCache}" IsEnabled="{x:Bind Vm.ActionsAvailable}" />
                        <Button Content="{l:Str Key=AppClearData}" IsEnabled="{x:Bind Vm.ActionsAvailable}" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="{l:Str Key=AppSectionWindow}" Style="{StaticResource SectionHeaderStyle}" />
            <StackPanel Spacing="4">
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE740;" FontSize="20" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{l:Str Key=AppSectionWindowDescription}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{l:Str Key=AppNotAvailableYet}" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE950;" FontSize="20" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{l:Str Key=AppSectionGpu}" />
                            <TextBlock Text="{l:Str Key=AppSectionGpuDescription}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{l:Str Key=AppNotAvailableYet}" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7E8;" FontSize="20" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{l:Str Key=AppSectionStartup}" />
                            <TextBlock Text="{l:Str Key=AppSectionStartupDescription}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2" IsEnabled="{x:Bind Vm.ActionsAvailable}" MinWidth="0" OnContent="" OffContent="" />
                    </Grid>
                </Border>
            </StackPanel>

            <TextBlock Text="{l:Str Key=AppSectionUninstall}" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE74D;" FontSize="20" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{l:Str Key=AppSectionUninstallDescription}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Content="{l:Str Key=AppUninstallButton}" IsEnabled="{x:Bind Vm.ActionsAvailable}" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
