<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Andruna.Manager: the management app (ADR 0005). WinUI 3 on the Windows App
    SDK, unpackaged, self-contained (no Windows App SDK runtime or .NET runtime
    has to be installed). Installed by installer/ into
    %LOCALAPPDATA%\Programs\Andruna.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <!-- Windows 11 only (ADR 0002). -->
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <RootNamespace>Andruna.Manager</RootNamespace>
    <AssemblyName>Andruna.Manager</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Andruna.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <!-- Only the two shipped languages go into the output (no satellite folders for others). -->
    <SatelliteResourceLanguages>en;he</SatelliteResourceLanguages>
    <!-- Program.cs has its own Main: single instance and activation redirection. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <!-- `dotnet build -r win-arm64` selects the ARM64 platform, `-r win-x64` x64. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == ''">
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' != 'ARM64'">win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <PropertyGroup>
    <Platform Condition="'$(RuntimeIdentifier)' == 'win-arm64'">ARM64</Platform>
    <Platform Condition="'$(RuntimeIdentifier)' == 'win-x64'">x64</Platform>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned versions. A version change is a reviewed change. -->
    <!-- WinUI and what it depends on only; the Windows App SDK metapackage would also ship AI, ML and widget runtimes. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="1.8.251222000" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7463" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Andruna.Manager.Core\Andruna.Manager.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Andruna.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\THIRD_PARTY_NOTICES" Link="THIRD_PARTY_NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\LICENSING.md" Link="LICENSING.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
